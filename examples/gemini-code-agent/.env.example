# Gemini Code Agent Configuration
# Copy this file to .env and fill in your credentials

# Required: Google AI API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: Model Selection
# Options: gemini-2.5-pro, gemini-flash-latest, gemini-flash-lite-latest
GEMINI_MODEL=gemini-2.5-pro

# Optional: API Endpoint Override
# Use this for Vertex AI or other endpoints
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: Streaming Configuration
GEMINI_STREAMING=true
GEMINI_BUFFER_SIZE=8192

# Optional: Budget Limits
GEMINI_BUDGET_HOURLY=0.50
GEMINI_BUDGET_DAILY=5.00
GEMINI_BUDGET_MONTHLY=50.00

# Optional: Performance Tuning
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.9

# Optional: Tool Configuration
GEMINI_TOOL_TIMEOUT=30
GEMINI_PARALLEL_TOOLS=4

# Optional: Workspace Configuration
WORKSPACE_ROOT=./workspace
WORKSPACE_MAX_SIZE_MB=1000
WORKSPACE_AUTO_CLEANUP=true

# Optional: Logging
LOG_LEVEL=info
LOG_FORMAT=json
ARKAVO_DEBUG=false
ARKAVO_DEBUG_CHAT=false

# Optional: Benchmark Configuration
BENCHMARK_ITERATIONS=5
BENCHMARK_DATASET=lite
BENCHMARK_COUNT=10
