# Patch Metadata (checked by build.rs)
# BASE_COMMIT: c3b87cebf
# VERIFY_ABSENT: GGML_ASSERT([rsets->data count] == 0)
# VERIFY_PRESENT: Metal residency sets not freed before shutdown
#
# If VERIFY_ABSENT text is not found in the target file, the patch may
# have been merged upstream and can be removed.

From: Arkavo <noreply@arkavo.com>
Subject: [PATCH] metal: convert shutdown assertion to warning log

During process exit, Metal residency sets may not be fully cleaned up
due to static destructor ordering. Convert the fatal assertion to a
warning log, as the OS will reclaim GPU resources anyway.

This fixes crashes when applications use exit(), receive SIGINT, or
don't perfectly clean up all llama contexts before shutdown.

---
 ggml/src/ggml-metal/ggml-metal-device.m | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-device.m b/ggml/src/ggml-metal/ggml-metal-device.m
index eb4e2c209..507ae7232 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@ -604,8 +604,11 @@ void ggml_metal_rsets_free(ggml_metal_rsets_t rsets) {
         return;
     }

-    // note: if you hit this assert, most likely you haven't deallocated all Metal resources before exiting
-    GGML_ASSERT([rsets->data count] == 0);
+    // During process exit, resources may not be fully cleaned up - log warning instead of asserting
+    if ([rsets->data count] != 0) {
+        GGML_LOG_WARN("%s: %lu Metal residency sets not freed before shutdown (expected during process exit)\n",
+                      __func__, (unsigned long)[rsets->data count]);
+    }

     atomic_store_explicit(&rsets->d_stop, true, memory_order_relaxed);

